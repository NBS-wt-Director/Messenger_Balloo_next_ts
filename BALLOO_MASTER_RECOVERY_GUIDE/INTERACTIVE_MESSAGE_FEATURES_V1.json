{
  "$schema": "https://balloo.su/schemas/message-features-v1.json",
  "metadata": {
    "id": "INTERACTIVE_MESSAGE_FEATURES_V1",
    "version": "5.0",
    "date": "2026-06-29",
    "status": "ready_for_implementation",
    "author": "NLP-Core-Team",
    "location": "Ekaterinburg, Russia",
    "description": "Полная спецификация интерактивных функций сообщений V1",
    "source_files": [
      "trash/функции.md",
      "data/functions/main.json",
      "trash/features_sql.sql",
      "trash/экраны.md",
      "mockups/premium.html"
    ]
  },

  "metrics": {
    "definitions": [
      {
        "id": "ux",
        "name": "UX",
        "description": "Удобство использования",
        "weight": 0.25
      },
      {
        "id": "performance",
        "name": "Performance",
        "description": "Скорость работы",
        "weight": 0.20
      },
      {
        "id": "security",
        "name": "Security",
        "description": "Безопасность",
        "weight": 0.20
      },
      {
        "id": "completeness",
        "name": "Completeness",
        "description": "Полнота функций",
        "weight": 0.15
      },
      {
        "id": "scalability",
        "name": "Scalability",
        "description": "Масштабируемость",
        "weight": 0.10
      },
      {
        "id": "maintainability",
        "name": "Maintainability",
        "description": "Поддерживаемость",
        "weight": 0.10
      }
    ],
    "target_score": 8.3,
    "baseline_score": 7.5
  },

  "features": {
    "forward": {
      "id": "MESG-019",
      "name": "Пересылка сообщений",
      "name_en": "Message Forward",
      "type": "chat",
      "class": "feature",
      "premium": false,
      "priority": "P0",
      "status": "v1_included",
      "limits": {
        "max_chats": 5,
        "secret_chats_allowed": false,
        "preserve_sender": true,
        "edit_before_send": true
      },
      "api": {
        "endpoint": "POST /api/v1/messages/:id/forward",
        "payload": {
          "chat_ids": "uuid[]",
          "comment": "string?",
          "hide_sender": "boolean?"
        }
      },
      "database": {
        "table": "messages",
        "fields": [
          "forward_from_id UUID",
          "forward_from_sender UUID",
          "forward_from_chat UUID",
          "forward_count INTEGER DEFAULT 0",
          "forwarded_at TIMESTAMP"
        ]
      }
    },

    "edit": {
      "id": "MESG-017",
      "name": "Редактирование сообщений",
      "name_en": "Message Edit",
      "type": "chat",
      "class": "feature",
      "premium": false,
      "priority": "P0",
      "status": "v1_included",
      "limits": {
        "free": {
          "max_edits": 3,
          "time_limit": null,
          "history": false
        },
        "premium": {
          "max_edits": null,
          "time_limit": null,
          "history": true,
          "history_versions": 10
        }
      },
      "api": {
        "edit": "PUT /api/v1/messages/:id",
        "history": "GET /api/v1/messages/:id/history"
      },
      "database": {
        "table": "messages",
        "fields": [
          "is_edited BOOLEAN DEFAULT FALSE",
          "edited_at TIMESTAMP",
          "edit_count INTEGER DEFAULT 0",
          "edit_history JSONB"
        ]
      }
    },

    "delete": {
      "id": "MESG-018",
      "name": "Удаление сообщений",
      "name_en": "Message Delete",
      "type": "chat",
      "class": "feature",
      "premium": false,
      "priority": "P0",
      "status": "v1_included",
      "limits": {
        "for_self": {
          "time_limit": null,
          "description": "Удаление только у себя"
        },
        "for_all": {
          "time_limit_hours": 48,
          "description": "Удаление у всех участников"
        }
      },
      "api": {
        "endpoint": "DELETE /api/v1/messages/:id",
        "payload": {
          "for": "self | all"
        }
      },
      "database": {
        "table": "messages",
        "fields": [
          "is_deleted BOOLEAN DEFAULT FALSE",
          "deleted_at TIMESTAMP",
          "deleted_by UUID",
          "delete_for VARCHAR(10)"
        ]
      }
    },

    "scheduled": {
      "id": "MESG-058",
      "name": "Отложенные сообщения",
      "name_en": "Scheduled Messages",
      "type": ["chat", "utility"],
      "class": "feature",
      "premium": false,
      "priority": "P1",
      "status": "v1_included",
      "limits": {
        "free": {
          "max_scheduled": 5,
          "min_delay_minutes": 1,
          "max_delay_days": 30
        },
        "premium": {
          "max_scheduled": null,
          "min_delay_minutes": 1,
          "max_delay_days": 365
        }
      },
      "api": {
        "schedule": "POST /api/v1/messages/schedule",
        "list": "GET /api/v1/messages/scheduled",
        "update": "PUT /api/v1/messages/scheduled/:id",
        "cancel": "DELETE /api/v1/messages/scheduled/:id"
      },
      "database": {
        "table": "scheduled_messages",
        "fields": [
          "id UUID PRIMARY KEY",
          "chat_id UUID NOT NULL",
          "sender_id UUID NOT NULL",
          "content TEXT NOT NULL",
          "type VARCHAR(50) DEFAULT 'text'",
          "attachment_id UUID",
          "scheduled_at TIMESTAMP NOT NULL",
          "status VARCHAR(20) DEFAULT 'pending'",
          "sent_at TIMESTAMP",
          "error_message TEXT",
          "created_at TIMESTAMP",
          "updated_at TIMESTAMP"
        ],
        "indexes": [
          "idx_scheduled_at",
          "idx_scheduled_status"
        ]
      },
      "cron": {
        "frequency": "every_minute",
        "query": "SELECT * FROM scheduled_messages WHERE status = 'pending' AND scheduled_at <= NOW()"
      }
    },

    "templates": {
      "id": "SUGG-008",
      "name": "Шаблоны сообщений",
      "name_en": "Message Templates",
      "type": ["utility", "admin"],
      "class": "feature",
      "premium": false,
      "priority": "P1",
      "status": "v1_included",
      "limits": {
        "personal": {
          "free": 10,
          "premium": 100
        },
        "group": {
          "free": 5,
          "premium": 50
        },
        "system": {
          "free": false,
          "premium": true
        }
      },
      "variables": [
        "{{name}}",
        "{{username}}",
        "{{date}}",
        "{{time}}",
        "{{group}}",
        "{{rule1}}",
        "{{rule2}}",
        "{{rule3}}",
        "{{violation}}",
        "{{announcement}}"
      ],
      "api": {
        "create": "POST /api/v1/templates",
        "list": "GET /api/v1/templates",
        "use": "POST /api/v1/templates/:id/use",
        "update": "PUT /api/v1/templates/:id",
        "delete": "DELETE /api/v1/templates/:id"
      },
      "database": {
        "table": "message_templates",
        "fields": [
          "id UUID PRIMARY KEY",
          "user_id UUID NOT NULL",
          "chat_id UUID",
          "name VARCHAR(255) NOT NULL",
          "content TEXT NOT NULL",
          "variables JSONB DEFAULT '[]'",
          "category VARCHAR(50) DEFAULT 'personal'",
          "usage_count INTEGER DEFAULT 0",
          "created_at TIMESTAMP",
          "updated_at TIMESTAMP"
        ]
      }
    },

    "quick_replies": {
      "id": "SUGG-008-QR",
      "name": "Быстрые ответы",
      "name_en": "Quick Replies",
      "type": "utility",
      "class": "feature",
      "premium": false,
      "priority": "P2",
      "status": "v1_included",
      "limits": {
        "free": 20,
        "premium": 100,
        "max_length": 500,
        "hotkey_prefix": "/"
      },
      "api": {
        "create": "POST /api/v1/quick-replies",
        "list": "GET /api/v1/quick-replies",
        "use": "POST /api/v1/quick-replies/:id/use",
        "update": "PUT /api/v1/quick-replies/:id",
        "delete": "DELETE /api/v1/quick-replies/:id"
      },
      "database": {
        "table": "quick_replies",
        "fields": [
          "id UUID PRIMARY KEY",
          "user_id UUID NOT NULL",
          "text TEXT NOT NULL",
          "shortcut VARCHAR(50)",
          "usage_count INTEGER DEFAULT 0",
          "last_used_at TIMESTAMP",
          "created_at TIMESTAMP"
        ]
      }
    },

    "polls": {
      "id": "MESG-POLL",
      "name": "Опросы",
      "name_en": "Polls",
      "type": ["chat", "media"],
      "class": "feature",
      "premium": false,
      "priority": "P2",
      "status": "v1_included",
      "limits": {
        "min_options": 2,
        "max_options": 10,
        "multiple_choice": true,
        "anonymous": true,
        "close_date": true
      },
      "api": {
        "create": "POST /api/v1/polls",
        "get": "GET /api/v1/polls/:id",
        "vote": "POST /api/v1/polls/:id/vote",
        "results": "GET /api/v1/polls/:id/results"
      },
      "database": {
        "tables": ["polls", "poll_options", "poll_responses"]
      }
    },

    "quizzes": {
      "id": "MESG-QUIZ",
      "name": "Викторины",
      "name_en": "Quizzes",
      "type": ["chat", "media"],
      "class": "feature",
      "premium": false,
      "priority": "P2",
      "status": "v1_included",
      "limits": {
        "min_options": 2,
        "max_options": 10,
        "has_correct_answer": true,
        "explanation": true
      },
      "api": {
        "create": "POST /api/v1/quizzes",
        "get": "GET /api/v1/quizzes/:id",
        "answer": "POST /api/v1/quizzes/:id/answer"
      },
      "database": {
        "tables": ["quizzes", "quiz_options", "quiz_attempts"]
      }
    },

    "checklists": {
      "id": "MESG-LIST",
      "name": "Списки (Checklist)",
      "name_en": "Checklists",
      "type": ["chat", "media"],
      "class": "feature",
      "premium": false,
      "priority": "P2",
      "status": "v1_included",
      "collaborative": true,
      "limits": {
        "min_items": 1,
        "max_items": 100,
        "multiple_checkers": true
      },
      "api": {
        "create": "POST /api/v1/checklists",
        "get": "GET /api/v1/checklists/:id",
        "check_item": "PUT /api/v1/checklists/:id/items/:item_id"
      },
      "database": {
        "tables": ["checklists", "checklist_items"]
      }
    }
  },

  "questions_to_10": {
    "description": "Критические вопросы для достижения оценки 10/10 по всем метрикам",
    "total_questions": 10,

    "questions": [
      {
        "id": 1,
        "title": "Отложенные сообщения — Push-уведомление об отправке?",
        "title_en": "Scheduled Messages — Push notification on send?",
        "metrics_affected": [
          {"id": "ux", "weight": 0.15},
          {"id": "performance", "weight": 0.05}
        ],
        "context": "Когда отложенное сообщение фактически отправляется (в заданное время), нужно ли отправлять push-уведомление отправителю?",
        "options": [
          {
            "id": "1.1",
            "title": "Отправлять всегда",
            "recommended_for": ["premium"],
            "pros": [
              "Пользователь уверен что сообщение ушло",
              "Удобно для важных сообщений (поздравления, напоминания)",
              "Снижает тревожность 'а вдруг не отправилось?'"
            ],
            "cons": [
              "Дополнительная нагрузка на push-сервис (до 5 сообщений/день на пользователя)",
              "Может раздражать при частом использовании",
              "Дополнительный API call к Firebase/Yandex Push"
            ],
            "recommendation": "Рекомендуется для Premium пользователей, опционально для Free",
            "impact_score": 8
          },
          {
            "id": "1.2",
            "title": "Не отправлять никогда",
            "recommended_for": ["mvp"],
            "pros": [
              "Нет дополнительной нагрузки",
              "Нет риска spam-уведомлений",
              "Проще реализация"
            ],
            "cons": [
              "Пользователь не уверен в отправке",
              "Нужно заходить в приложение чтобы проверить",
              "Может снизить доверие к функции"
            ],
            "recommendation": "Подходит для MVP чтобы упростить запуск",
            "impact_score": 6
          },
          {
            "id": "1.3",
            "title": "Только если пользователь офлайн в момент отправки",
            "recommended_for": ["v1_optimal"],
            "pros": [
              "Баланс между информированием и спамом",
              "Логично: если онлайн — увидит сам",
              "Экономия ресурсов"
            ],
            "cons": [
              "Сложнее реализация (нужно проверять online статус)",
              "Требует WebSocket интеграции"
            ],
            "recommendation": "Оптимальный выбор для V1",
            "impact_score": 9
          },
          {
            "id": "1.4",
            "title": "Настройка в настройках",
            "recommended_for": ["v2"],
            "pros": [
              "Полный контроль у пользователя",
              "Гибкость",
              "Снижает негатив от нежелательных уведомлений"
            ],
            "cons": [
              "Сложнее UI (ещё одна настройка)",
              "Пользователи могут не найти",
              "Нужно хранить состояние в БД"
            ],
            "recommendation": "Рекомендуется для V2, не для V1",
            "impact_score": 7
          }
        ],
        "recommended_option": "1.3",
        "v1_decision": null
      },

      {
        "id": 2,
        "title": "Отложенные сообщения — Отдельный виджет в главном меню?",
        "title_en": "Scheduled Messages — Separate widget in main menu?",
        "metrics_affected": [
          {"id": "ux", "weight": 0.20},
          {"id": "completeness", "weight": 0.10}
        ],
        "context": "Где отображать список запланированных сообщений?",
        "options": [
          {
            "id": "2.1",
            "title": "Только в настройках чата",
            "recommended_for": ["mvp"],
            "pros": [
              "Простая реализация",
              "Логичная группировка по чатам",
              "Не загромождает интерфейс"
            ],
            "cons": [
              "Нужно заходить в каждый чат",
              "Не видно общую картину",
              "Сложно управлять всеми запланированными"
            ],
            "recommendation": "Подходит для MVP",
            "impact_score": 6
          },
          {
            "id": "2.2",
            "title": "Отдельная страница в меню",
            "recommended_for": ["v1_recommended"],
            "pros": [
              "Все запланированные в одном месте",
              "Удобно управлять",
              "Видно общую статистику"
            ],
            "cons": [
              "Дополнительная страница",
              "Усложнение навигации",
              "Требует отдельного роутинга"
            ],
            "recommendation": "Рекомендуется для V1 — важно для UX",
            "impact_score": 9
          },
          {
            "id": "2.3",
            "title": "Выпадающий список в поле ввода",
            "recommended_for": ["v1_additional"],
            "pros": [
              "Быстрый доступ из любого чата",
              "Контекстно (видно в каком чате отправится)",
              "Компактно"
            ],
            "cons": [
              "Может перекрывать поле ввода",
              "Сложно при большом количестве",
              "Не видно все запланированные сразу"
            ],
            "recommendation": "Хорошее дополнение к Варианту 2.2",
            "impact_score": 7
          },
          {
            "id": "2.4",
            "title": "Уведомление в списке чатов",
            "recommended_for": ["v1.5"],
            "pros": [
              "Видно сразу в списке чатов",
              "Не требует дополнительных страниц",
              "Интуитивно понятно"
            ],
            "cons": [
              "Загромождает список чатов",
              "Нужно менять компонент ChatList",
              "Может конфликтовать с другими бейджами"
            ],
            "recommendation": "Дополнительная фича для V1.5",
            "impact_score": 8
          }
        ],
        "recommended_option": "2.2",
        "v1_decision": null
      },

      {
        "id": 3,
        "title": "Шаблоны — Общие или привязанные к группам?",
        "title_en": "Templates — Global or group-specific?",
        "metrics_affected": [
          {"id": "ux", "weight": 0.15},
          {"id": "scalability", "weight": 0.10}
        ],
        "context": "Должны ли шаблоны быть глобальными для пользователя или привязанными к конкретным группам?",
        "options": [
          {
            "id": "3.1",
            "title": "Только глобальные (личные)",
            "recommended_for": ["basic"],
            "pros": [
              "Простая реализация (одна таблица)",
              "Удобно для личных шаблонов",
              "Меньше данных в БД"
            ],
            "cons": [
              "Не подходит для групповых шаблонов",
              "Админы не могут создать шаблон для конкретной группы",
              "Ограничивает сценарии использования"
            ],
            "recommendation": "Подходит для базовой версии",
            "impact_score": 6
          },
          {
            "id": "3.2",
            "title": "Гибридные (личные + групповые)",
            "recommended_for": ["v1_recommended"],
            "pros": [
              "Максимальная гибкость",
              "Админы могут создавать шаблоны для своей группы",
              "Разделение прав доступа"
            ],
            "cons": [
              "Сложнее БД (нужно chat_id)",
              "Нужно проверять права доступа",
              "Может запутать пользователей"
            ],
            "recommendation": "Рекомендуется для V1 — критично для админов групп",
            "impact_score": 9
          },
          {
            "id": "3.3",
            "title": "Только групповые",
            "recommended_for": [],
            "pros": [
              "Логично для групповых чатов",
              "Админы контролируют контент"
            ],
            "cons": [
              "Бесполезно для личных чатов",
              "Ограничивает сценарии",
              "Не подходит для поддержки"
            ],
            "recommendation": "Не рекомендуется",
            "impact_score": 4
          },
          {
            "id": "3.4",
            "title": "Системные шаблоны (платформа)",
            "recommended_for": ["v2"],
            "pros": [
              "Админы платформы могут создать шаблоны для всех",
              "Полезно для правил, приветствий",
              "Централизованное управление"
            ],
            "cons": [
              "Требует роль 'system_admin'",
              "Риск злоупотреблений",
              "Сложнее права доступа"
            ],
            "recommendation": "V2 функция, не для MVP",
            "impact_score": 7
          }
        ],
        "recommended_option": "3.2",
        "v1_decision": null
      },

      {
        "id": 4,
        "title": "Шаблоны — Импорт/экспорт (JSON)?",
        "title_en": "Templates — Import/Export (JSON)?",
        "metrics_affected": [
          {"id": "ux", "weight": 0.10},
          {"id": "maintainability", "weight": 0.15}
        ],
        "context": "Нужна ли возможность экспортировать шаблоны в JSON и импортировать обратно?",
        "options": [
          {
            "id": "4.1",
            "title": "Да, полный импорт/экспорт",
            "recommended_for": ["premium"],
            "pros": [
              "Удобно для бэкапа",
              "Можно делиться шаблонами",
              "Перенос между аккаунтами"
            ],
            "cons": [
              "Сложнее реализация",
              "Риск импорта вредоносных шаблонов",
              "Нужно валидировать JSON"
            ],
            "recommendation": "Рекомендуется для Premium",
            "impact_score": 8
          },
          {
            "id": "4.2",
            "title": "Только экспорт",
            "recommended_for": ["v1_compromise"],
            "pros": [
              "Проще реализация",
              "Нет риска вредоносного импорта",
              "Пользователи могут делать бэкап"
            ],
            "cons": [
              "Неполноценная функция",
              "Нельзя восстановить из бэкапа",
              "Разочарование пользователей"
            ],
            "recommendation": "Компромисс для V1",
            "impact_score": 7
          },
          {
            "id": "4.3",
            "title": "Нет импорта/экспорта",
            "recommended_for": [],
            "pros": [
              "Максимально простая реализация",
              "Нет дополнительных endpoints",
              "Нет валидации"
            ],
            "cons": [
              "Нельзя сделать бэкап",
              "Нельзя поделиться",
              "При удалении аккаунта шаблоны теряются"
            ],
            "recommendation": "Не рекомендуется для V1",
            "impact_score": 4
          },
          {
            "id": "4.4",
            "title": "Библиотека шаблонов (маркетплейс)",
            "recommended_for": ["v2-v3"],
            "pros": [
