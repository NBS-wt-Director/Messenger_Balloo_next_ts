        "metrics_affected": [{"id": "security", "weight": 0.15}, {"id": "maintainability", "weight": 0.10}, {"id": "performance", "weight": 0.05}],
        "recommended_option": "7.1",
        "decision": "До 10 версий (Premium)"
      },
      {
        "id": 8,
        "title": "Удаление — 48 часов или безлимит?",
        "title_en": "Delete — 48 hours or unlimited?",
        "metrics_affected": [{"id": "ux", "weight": 0.15}, {"id": "security", "weight": 0.10}],
        "recommended_option": "8.1",
