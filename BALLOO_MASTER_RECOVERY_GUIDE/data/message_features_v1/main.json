  "metrics_target": {
    "baseline_score": 7.5,
    "target_score": 8.3,
    "definitions": [
      {"id": "ux", "name": "UX", "description": "Удобство использования", "weight": 0.25},
      {"id": "performance", "name": "Performance", "description": "Скорость работы", "weight": 0.20},
      {"id": "security", "name": "Security", "description": "Безопасность", "weight": 0.20},
      {"id": "completeness", "name": "Completeness", "description": "Полнота функций", "weight": 0.15},
      {"id": "scalability", "name": "Scalability", "description": "Масштабируемость", "weight": 0.10},
      {"id": "maintainability", "name": "Maintainability", "description": "Поддерживаемость", "weight": 0.10}
    ]
  },

  "features": {
    "forward": {
      "id": "MESG-019",
      "name": "Пересылка сообщений",
      "name_en": "Message Forward",
      "type": "chat",
      "class": "feature",
      "premium": false,
      "priority": "P0",
      "status": "v1_included",
      "limits": {
        "max_chats": 5,
        "secret_chats_allowed": false,
        "preserve_sender": true,
        "edit_before_send": true
      }
    },

    "edit": {
      "id": "MESG-017",
      "name": "Редактирование сообщений",
      "name_en": "Message Edit",
      "type": "chat",
      "class": "feature",
      "premium": false,
      "priority": "P0",
      "status": "v1_included",
      "limits": {
        "free": {"max_edits": 3, "time_limit": null, "history": false},
        "premium": {"max_edits": null, "time_limit": null, "history": true, "history_versions": 10}
      }
    },

    "delete": {
      "id": "MESG-018",
      "name": "Удаление сообщений",
      "name_en": "Message Delete",
      "type": "chat",
      "class": "feature",
      "premium": false,
      "priority": "P0",
      "status": "v1_included",
      "limits": {
        "for_self": {"time_limit": null, "description": "Удаление только у себя"},
        "for_all": {"time_limit_hours": 48, "description": "Удаление у всех участников"}
      }
    },

    "scheduled": {
      "id": "MESG-058",
      "name": "Отложенные сообщения",
      "name_en": "Scheduled Messages",
      "type": ["chat", "utility"],
      "class": "feature",
      "premium": false,
      "priority": "P1",
      "status": "v1_included",
      "limits": {
        "free": {"max_scheduled": 5, "min_delay_minutes": 1, "max_delay_days": 30},
        "premium": {"max_scheduled": null, "min_delay_minutes": 1, "max_delay_days": 365}
      }
    },

    "templates": {
      "id": "SUGG-008",
      "name": "Шаблоны сообщений",
      "name_en": "Message Templates",
      "type": ["utility", "admin"],
      "class": "feature",
      "premium": false,
      "priority": "P1",
      "status": "v1_included",
      "limits": {
        "personal": {"free": 10, "premium": 100},
        "group": {"free": 5, "premium": 50},
        "system": {"free": false, "premium": true}
      },
      "variables": ["{{name}}", "{{username}}", "{{date}}", "{{time}}", "{{group}}", "{{rule1}}", "{{rule2}}", "{{rule3}}", "{{violation}}", "{{announcement}}"]
    },

    "quick_replies": {
      "id": "SUGG-008-QR",
      "name": "Быстрые ответы",
      "name_en": "Quick Replies",
      "type": "utility",
      "class": "feature",
      "premium": false,
      "priority": "P2",
      "status": "v1_included",
      "limits": {"free": 20, "premium": 100, "max_length": 500, "hotkey_prefix": "/"}
    },

    "polls": {
      "id": "MESG-POLL",
      "name": "Опросы",
      "name_en": "Polls",
      "type": ["chat", "media"],
      "class": "feature",
      "premium": false,
      "priority": "P2",
      "status": "v1_included",
      "limits": {"min_options": 2, "max_options": 10, "multiple_choice": true, "anonymous": true, "close_date": true}
    },

    "quizzes": {
      "id": "MESG-QUIZ",
      "name": "Викторины",
      "name_en": "Quizzes",
      "type": ["chat", "media"],
      "class": "feature",
      "premium": false,
      "priority": "P2",
      "status": "v1_included",
      "limits": {"min_options": 2, "max_options": 10, "has_correct_answer": true, "explanation": true}
    },

    "checklists": {
      "id": "MESG-LIST",
      "name": "Списки (Checklist)",
      "name_en": "Checklists",
      "type": ["chat", "media"],
      "class": "feature",
      "premium": false,
      "priority": "P2",
      "status": "v1_included",
      "collaborative": true,
      "limits": {"min_items": 1, "max_items": 100, "multiple_checkers": true}
    }
  },

  "questions_to_10": {
    "total_questions": 10,
    "questions": [
      {
        "id": 1,
        "title": "Отложенные сообщения — Push-уведомление об отправке?",
        "title_en": "Scheduled Messages — Push notification on send?",
        "metrics_affected": [{"id": "ux", "weight": 0.15}, {"id": "performance", "weight": 0.05}],
        "recommended_option": "1.3",
        "decision": "Только если пользователь офлайн"
      },
      {
        "id": 2,
        "title": "Отложенные сообщения — Отдельный виджет в главном меню?",
        "title_en": "Scheduled Messages — Separate widget in main menu?",
        "metrics_affected": [{"id": "ux", "weight": 0.20}, {"id": "completeness", "weight": 0.10}],
        "recommended_option": "2.2",
        "decision": "Отдельная страница + бейджи"
      },
      {
        "id": 3,
        "title": "Шаблоны — Общие или привязанные к группам?",
