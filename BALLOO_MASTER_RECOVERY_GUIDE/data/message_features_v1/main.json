  "api_endpoints_summary": {
    "forward": ["POST /api/v1/messages/:id/forward"],
    "edit": ["PUT /api/v1/messages/:id", "GET /api/v1/messages/:id/history"],
    "delete": ["DELETE /api/v1/messages/:id?for=self|all"],
    "scheduled": ["POST /api/v1/messages/schedule", "GET /api/v1/messages/scheduled", "PUT /api/v1/messages/scheduled/:id", "DELETE /api/v1/messages/scheduled/:id"],
    "templates": ["POST /api/v1/templates", "GET /api/v1/templates", "PUT /api/v1/templates/:id", "DELETE /api/v1/templates/:id", "POST /api/v1/templates/:id/use"],
    "quick_replies": ["POST /api/v1/quick-replies", "GET /api/v1/quick-replies", "PUT /api/v1/quick-replies/:id", "DELETE /api/v1/quick-replies/:id", "POST /api/v1/quick-replies/:id/use"],
    "polls": ["POST /api/v1/polls", "GET /api/v1/polls/:id", "POST /api/v1/polls/:id/vote", "GET /api/v1/polls/:id/results"],
    "quizzes": ["POST /api/v1/quizzes", "GET /api/v1/quizzes/:id", "POST /api/v1/quizzes/:id/answer"],
    "checklists": ["POST /api/v1/checklists", "GET /api/v1/checklists/:id", "PUT /api/v1/checklists/:id/items/:item_id"]
  },

  "competitive_analysis": {
    "unique_advantages": [
      "Отложенные сообщения — есть только у нас в V1",
      "Шаблоны для админов — уникальная фича",
      "Викторины (Quiz) — нет у конкурентов",
      "Списки (Checklist) — нет у конкурентов",
      "Быстрые ответы — есть только в бизнес-мессенджерах"
    ]
  },

  "database_tables": {
    "messages": {
      "fields": [
        "forward_from_id UUID",
        "forward_from_sender UUID",
        "forward_from_chat UUID",
        "forward_count INTEGER DEFAULT 0",
        "forwarded_at TIMESTAMP",
        "is_edited BOOLEAN DEFAULT FALSE",
        "edited_at TIMESTAMP",
        "edit_count INTEGER DEFAULT 0",
        "edit_history JSONB",
        "is_deleted BOOLEAN DEFAULT FALSE",
        "deleted_at TIMESTAMP",
        "deleted_by UUID",
        "delete_for VARCHAR(10)"
      ]
    },
    "scheduled_messages": {
      "fields": [
        "id UUID PRIMARY KEY",
        "chat_id UUID NOT NULL",
        "sender_id UUID NOT NULL",
        "content TEXT NOT NULL",
        "type VARCHAR(50) DEFAULT 'text'",
        "attachment_id UUID",
        "scheduled_at TIMESTAMP NOT NULL",
        "status VARCHAR(20) DEFAULT 'pending'",
        "sent_at TIMESTAMP",
        "error_message TEXT",
        "created_at TIMESTAMP",
        "updated_at TIMESTAMP"
      ],
      "indexes": ["idx_scheduled_at", "idx_scheduled_status"]
    },
    "message_templates": {
      "fields": [
        "id UUID PRIMARY KEY",
        "user_id UUID NOT NULL",
        "chat_id UUID",
        "name VARCHAR(255) NOT NULL",
        "content TEXT NOT NULL",
        "variables JSONB DEFAULT '[]'",
        "category VARCHAR(50) DEFAULT 'personal'",
        "usage_count INTEGER DEFAULT 0",
        "created_at TIMESTAMP",
        "updated_at TIMESTAMP"
      ]
    },
    "quick_replies": {
      "fields": [
        "id UUID PRIMARY KEY",
        "user_id UUID NOT NULL",
        "text TEXT NOT NULL",
        "shortcut VARCHAR(50)",
        "usage_count INTEGER DEFAULT 0",
        "last_used_at TIMESTAMP",
        "created_at TIMESTAMP"
      ]
    },
    "polls": {
      "tables": ["polls", "poll_options", "poll_responses"]
    },
    "quizzes": {
      "tables": ["quizzes", "quiz_options", "quiz_attempts"]
    },
    "checklists": {
      "tables": ["checklists", "checklist_items"]
    }
  }
}
