{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppScreen Object Schema",
  "description": "Schema for canonical Screen documentation objects",
  "type": "object",
  "required": ["objectType", "nodeId", "appId", "screenId", "title", "status"],
  "properties": {
    "objectType": {
      "type": "string",
      "const": "screen",
      "description": "Fixed object type identifier"
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "description": "Node ID in the monorepo"
    },
    "appId": {
      "type": "string",
      "minLength": 1,
      "description": "Application ID within the node"
    },
    "screenId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique screen identifier (kebab-case)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Screen title"
    },
    "purpose": {
      "type": "string",
      "maxLength": 1000,
      "description": "Brief description of screen purpose"
    },
    "actors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "User roles interacting with this screen"
    },
    "entryConditions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Entry conditions for the screen"
    },
    "exitConditions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Exit conditions from the screen"
    },
    "elements": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Interface elements on the screen"
    },
    "actions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Actions available on the screen"
    },
    "relatedTransitions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of related transitions"
    },
    "relatedScenarios": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of related scenarios"
    },
    "relatedIntegrations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "IDs of related integrations"
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["contract", "code", "report", "state", "playbook", "config"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "lineRange": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"],
      "description": "Screen status"
    }
  },
  "additionalProperties": false
}
