{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppIntegration Object Schema",
  "description": "Schema for canonical Integration documentation objects",
  "type": "object",
  "required": ["objectType", "nodeId", "appId", "integrationId", "title", "direction", "targetType", "targetId", "purpose", "status"],
  "properties": {
    "objectType": {
      "type": "string",
      "const": "integration",
      "description": "Fixed object type identifier"
    },
    "nodeId": {
      "type": "string",
      "minLength": 1
    },
    "appId": {
      "type": "string",
      "minLength": 1
    },
    "integrationId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Unique integration identifier (kebab-case)"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "direction": {
      "type": "string",
      "enum": ["inbound", "outbound", "bidirectional"],
      "description": "Data flow direction"
    },
    "targetType": {
      "type": "string",
      "enum": ["app", "node", "service", "external-system"],
      "description": "Type of target system"
    },
    "targetId": {
      "type": "string",
      "minLength": 1,
      "description": "Target system identifier"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "description": "Purpose of this integration"
    },
    "trigger": {
      "type": "string"
    },
    "input": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "protocolOrChannel": {
      "type": "string"
    },
    "authRequirements": {
      "type": "string"
    },
    "failureHandling": {
      "type": "string"
    },
    "relatedScreens": {
      "type": "array",
      "items": { "type": "string" }
    },
    "relatedTransitions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "relatedScenarios": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": { "type": "string", "enum": ["contract", "code", "report", "state", "playbook", "config"] },
          "path": { "type": "string", "minLength": 1 },
          "title": { "type": "string" },
          "lineRange": { "type": "string" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    }
  },
  "additionalProperties": false
}
