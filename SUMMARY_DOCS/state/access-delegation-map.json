  ],
  "forbiddenDelegations": [
    {
      "rule": "no-self-delegation",
      "description": "creator-superadmin cannot delegate own role",
      "reason": "Canonical creator role is unique"
    },
    {
      "rule": "no-implicit-admin",
      "description": "No implicit admin inheritance",
      "reason": "All delegation must be explicit"
    },
    {
      "rule": "no-cross-environment",
      "description": "No cross-environment privilege delegation",
      "reason": "Environment separation must be maintained"
    },
    {
      "rule": "no-wildcard-permissions",
      "description": "No wildcard permissions delegation",
      "reason": "Scopes must be specific"
    },
    {
      "rule": "delegated-cannot-delegate",
      "description": "delegated-node-admin cannot delegate further",
      "reason": "Single-level delegation only"
    }
  ],
  "delegationTypes": {
    "temporary": {
      "description": "Time-limited access grant",
      "requiresExpiry": true,
      "maxDuration": "90d",
      "renewalRequiresApproval": true
    },
    "persistent": {
      "description": "Until explicitly revoked",
      "requiresExpiry": false,
      "maxDuration": null,
      "renewalRequiresApproval": false
    },
    "read-only": {
      "description": "View access only",
      "allowedScopes": ["read"],
      "modificationAllowed": false
    },
    "operational": {
      "description": "Day-to-day operations",
      "allowedScopes": ["use", "manage", "deploy"],
      "modificationAllowed": true
    },
    "configuration": {
      "description": "Configuration changes only",
      "allowedScopes": ["configure"],
      "modificationAllowed": true
    }
  },
  "revocationRules": {
    "immediateRevocation": [
      "security_incident",
      "terms_violation",
      "employment_termination",
      "creator-superadmin_request"
    ],
    "scheduledRevocation": [
      "delegation_expiry",
      "role_change",
      "environment_change"
    ],
    "automaticRevocation": [
      "alpha_program_end",
      "sandbox_access_period_end"
    ]
  },
  "auditRequirements": {
    "logDelegationGrant": true,
    "logDelegationRevoke": true,
    "logDelegationUse": true,
    "logDelegationExpiry": true,
    "retentionPeriod": "90d",
    "accessibleTo": ["creator-superadmin", "delegated-node-admin:audit"]
  },
  "metadata": {
    "totalDelegationRules": 8,
    "forbiddenDelegationRules": 5,
    "delegationTypes": 5,
    "revocableDelegations": 8,
    "lastUpdated": "2026-06-13"
  }
}
