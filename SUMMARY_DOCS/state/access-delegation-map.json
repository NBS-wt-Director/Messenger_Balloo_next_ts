{
  "$schema": "../schemas/access-delegation.schema.json",
  "version": "1.0.0",
  "dateCreated": "2026-06-13",
  "status": "active",
  "description": "Delegation map for Balloo access control",
  "delegationRules": [
    {
      "ruleId": "delegation-001",
      "delegatorRole": "creator-superadmin",
      "delegatorNode": "projectgeneralsettings.working.balloo.su",
      "targetNode": "any",
      "allowedDelegatedRoles": [
        "delegated-node-admin"
      ],
      "delegableScopes": [
        "node:read:assigned",
        "node:write:assigned",
        "node:configure:assigned",
        "node:admin:assigned",
        "access:read:assigned",
        "access:grant:assigned",
        "access:revoke:assigned"
      ],
      "revocable": true,
      "approvalNotes": "creator-superadmin can delegate per-node admin access to delegated-node-admin role",
      "delegationType": ["temporary", "persistent"],
      "maxDelegationDuration": null,
      "requiresJustification": true,
      "auditLevel": "maximum"
    },
    {
