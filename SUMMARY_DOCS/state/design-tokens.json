  "brandColors": {
    "primary": {
      "name": "Russia Blue",
      "hex": "#0039A6",
      "usage": "Main brand color, headers, primary actions"
    },
    "secondary": {
      "name": "Russia Red",
      "hex": "#D52B1E",
      "usage": "Accent color, highlights, secondary actions"
    },
    "accent": {
      "name": "Modern Blue",
      "hex": "#007bff",
      "usage": "Interactive elements, links, buttons"
    },
    "white": {
      "name": "White",
      "hex": "#ffffff",
      "usage": "Backgrounds, light text"
    }
  },
  "statusColors": {
    "healthy": {
      "hex": "#10b981",
      "usage": "Health status, success states"
    },
    "degraded": {
      "hex": "#f59e0b",
      "usage": "Degraded status, warnings"
    },
    "failed": {
      "hex": "#dc2626",
      "usage": "Failed status, errors"
    },
    "startup": {
      "hex": "#3b82f6",
      "usage": "Startup status, in progress"
    },
    "maintenance": {
      "hex": "#6b7280",
      "usage": "Maintenance status, disabled"
    }
  },
  "typography": {
    "fontFamilies": {
      "primary": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif",
      "monospace": "'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace"
    },
    "fontSizes": {
      "xs": { "value": "12px", "rem": "0.75rem", "usage": "Captions, footnotes" },
      "sm": { "value": "14px", "rem": "0.875rem", "usage": "Secondary text" },
      "base": { "value": "16px", "rem": "1rem", "usage": "Body text" },
      "lg": { "value": "18px", "rem": "1.125rem", "usage": "Subheadings" },
      "xl": { "value": "20px", "rem": "1.25rem", "usage": "Section titles" },
      "2xl": { "value": "24px", "rem": "1.5rem", "usage": "Page titles" },
      "3xl": { "value": "30px", "rem": "1.875rem", "usage": "Hero text" }
    },
    "fontWeights": {
      "normal": { "value": 400, "usage": "Body text" },
      "medium": { "value": 500, "usage": "Emphasis, buttons" },
      "bold": { "value": 700, "usage": "Headings, strong emphasis" }
    }
  },
  "spacing": {
    "scale": {
      "1": { "value": "4px", "usage": "Micro spacing" },
      "2": { "value": "8px", "usage": "Tight spacing" },
      "3": { "value": "12px", "usage": "Component padding" },
      "4": { "value": "16px", "usage": "Base spacing" },
      "5": { "value": "20px", "usage": "Section spacing" },
      "6": { "value": "24px", "usage": "Card padding" },
      "8": { "value": "32px", "usage": "Large spacing" },
      "12": { "value": "48px", "usage": "Page sections" }
    },
    "logoClearSpace": {
      "value": "8px",
      "rule": "Minimum clear space around logo on all sides"
    }
  },
  "breakpoints": {
    "mobile": {
      "max": "640px",
      "fontSize": "14px",
      "touchTarget": "44px"
    },
    "tablet": {
      "min": "641px",
      "max": "1024px",
      "fontSize": "16px"
    },
    "desktop": {
      "min": "1024px",
      "max": "1200px",
      "fontSize": "16px"
    }
  },
  "shadows": {
    "modal": {
      "value": "0 25px 50px -12px rgba(0, 0, 0, 0.25)",
      "usage": "Modal dialogs"
    },
    "card": {
      "value": "0 4px 6px -1px rgba(0, 0, 0, 0.1)",
      "usage": "Cards (when needed)"
    }
  },
  "animations": {
    "fadeIn": {
      "keyframes": "from { opacity: 0; } to { opacity: 1; }",
      "duration": "0.2s",
      "easing": "ease-out"
    },
    "slideIn": {
      "keyframes": "from { transform: translateY(10px); opacity: 0; } to { transform: translateY(0); opacity: 1; }",
      "duration": "0.2s",
      "easing": "ease-out"
    },
    "slideUp": {
      "keyframes": "from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); }",
      "duration": "0.3s",
      "easing": "ease-out"
    },
    "pulse": {
      "keyframes": "0%, 100% { opacity: 1; } 50% { opacity: 0.5; }",
      "duration": "2s",
      "iteration": "infinite"
    }
  }
}
