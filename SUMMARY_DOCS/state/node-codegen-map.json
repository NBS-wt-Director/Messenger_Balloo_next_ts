  "safetyChecks": {
    "preGeneration": [
      "validate_node_id_unique",
      "validate_branch_exists",
      "validate_domain_available",
      "validate_port_available",
      "validate_dependencies_exist",
      "check_conflicts"
    ],
    "postGeneration": [
      "validate_generated_code_syntax",
      "validate_config_json",
      "validate_docs_links",
      "run_linter",
      "run_type_check",
      "run_tests"
    ],
    "deployment": [
      "validate_environment_match",
      "validate_secrets_present",
      "validate_routing_config",
      "health_check_ready",
      "rollback_plan_exists"
    ]
  },
  "scopeRestrictions": {
    "canCreate": true,
    "canUpdate": true,
    "canDelete": false,
    "canDeployProduction": false,
    "requiresApprovalFor": ["production_deploy", "breaking_changes"]
  }
