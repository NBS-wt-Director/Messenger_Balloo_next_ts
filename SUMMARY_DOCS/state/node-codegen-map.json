{
  "version": "1.0.0",
  "date": "2026-06-13",
  "status": "active",
  "description": "Node codegen relevance map for Balloo node registry",
  "codegenClasses": {
    "class_1_technical_core": {
      "description": "Technical core nodes (Priority 1)",
      "characteristics": [
        "Full codegen support",
        "Config generation for all environments",
        "Docs generation required",
        "Infrastructure as code",
        "Safety checks mandatory"
      ]
    },
    "class_2_working_nodes": {
      "description": "Working nodes (Priority 2)",
      "characteristics": [
        "Code generation",
        "Config generation",
        "Basic docs",
        "Optional IaC"
      ]
    },
    "class_3_alpha_nodes": {
      "description": "Alpha nodes (Priority 3)",
      "characteristics": [
        "Config generation from working",
        "Minimal code changes",
        "Testing-focused docs"
      ]
    },
    "class_4_production_nodes": {
      "description": "Production nodes (Priority 4)",
      "characteristics": [
        "Stable code (no generation unless update)",
        "Production config generation",
        "Full docs",
        "Production IaC"
      ]
    }
  },
