{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Platform Languages Manifest",
  "description": "Список поддерживаемых языков платформы Balloo",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "defaultLanguage": { "type": "string" },
    "fallbackLanguage": { "type": "string" },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "nativeName": { "type": "string" },
          "priority": { "type": "integer" },
          "enabled": { "type": "boolean" }
        },
        "required": ["code", "name", "nativeName"]
      }
    }
  },
  "required": ["version", "languages"]
}