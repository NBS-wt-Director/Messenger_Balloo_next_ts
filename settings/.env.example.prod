# ==========================================
# App Balloo - Shared Settings (Production)
# ==========================================

# Окружение
NODE_ENV=production
PLATFORM=web

# ===== ПРИЛОЖЕНИЕ =====
APP_NAME=Balloo Messenger
APP_URL=https://alpha.balloo.su

# ===== БЕЗОПАСНОСТЬ =====
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION_MIN_32_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_KEY=CHANGE_THIS_32_CHAR_KEY

# ===== БАЗА ДАННЫХ =====
DB_PATH=/var/lib/balloo/data/database.sqlite

# ===== PUSH УВЕДОМЛЕНИЯ =====
VAPID_PUBLIC_KEY=your-production-vapid-public-key
VAPID_PRIVATE_KEY=your-production-vapid-private-key
VAPID_SUBJECT=mailto:admin@balloo.ru

# ===== YANDEX OAUTH =====
YANDEX_CLIENT_ID=production-yandex-client-id
YANDEX_CLIENT_SECRET=production-yandex-client-secret
YANDEX_REDIRECT_URI=https://alpha.balloo.su/api/auth/yandex/callback

# ===== EMAIL =====
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_USER=your-production-email@yandex.ru
EMAIL_PASSWORD=your-production-app-password

# ===== РАЗМЕРЫ ФАЙЛОВ =====
MAX_FILE_SIZE=52428800
UPLOAD_DIR=/var/lib/balloo/uploads
RECORDINGS_DIR=/var/lib/balloo/recordings

# ===== АДМИН =====
SUPER_ADMIN_EMAIL=admin@balloo.ru
DEFAULT_ADMIN_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# ===== ТЕСТОВЫЕ ПОЛЬЗОВАТЕЛИ (ОТКЛЮЧИТЬ В ПРОДАКШЕНЕ!) =====
# TEST_USER_1_EMAIL=

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== ФУНКЦИИ =====
REGISTRATION_ENABLED=false
MAINTENANCE_MODE=false

# ===== CORS =====
CORS_ORIGIN=https://alpha.balloo.su

# ===== API =====
API_URL=https://api.balloo.su/api
