# ==========================================
# App Balloo - Shared Settings (Development)
# ==========================================

# Окружение
NODE_ENV=development
PLATFORM=web

# ===== ПРИЛОЖЕНИЕ =====
APP_NAME=Balloo Messenger
APP_URL=http://localhost:3000

# ===== БЕЗОПАСНОСТЬ =====
# Сгенерировать: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-min-32-characters-here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10
ENCRYPTION_KEY=32-character-encryption-key-here

# ===== ГЕНЕРАЛЬНЫЙ ПАРОЛЬ (Creator-Superadmin Privileged Access) =====
# Используется для privileged verification в App Docs Editor
# Никогда не передавать клиенту, не логировать, не светить в UI
GENERAL_PASSWORD=A13n10n13a

# ===== БАЗА ДАННЫХ =====
DB_PATH=./data/database.sqlite

# ===== PUSH УВЕДОМЛЕНИЯ =====
# Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@balloo.ru

# ===== YANDEX OAUTH =====
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/yandex/callback

# ===== EMAIL =====
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_USER=your-email@yandex.ru
EMAIL_PASSWORD=your-app-password

# ===== РАЗМЕРЫ ФАЙЛОВ =====
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads
RECORDINGS_DIR=./recordings

# ===== АДМИН =====
SUPER_ADMIN_EMAIL=admin@balloo.ru
DEFAULT_ADMIN_PASSWORD=BallooAdmin2024!

# ===== ТЕСТОВЫЕ ПОЛЬЗОВАТЕЛИ =====
TEST_USER_1_EMAIL=admin@balloo.ru
TEST_USER_1_PASSWORD=Admin123!
TEST_USER_1_NAME=Администратор
TEST_USER_1_IS_ADMIN=true
TEST_USER_1_IS_SUPER_ADMIN=true

TEST_USER_2_EMAIL=user1@balloo.ru
TEST_USER_2_PASSWORD=User123!
TEST_USER_2_NAME=Тестовый пользователь
TEST_USER_2_IS_ADMIN=false

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== ФУНКЦИИ =====
REGISTRATION_ENABLED=true
MAINTENANCE_MODE=false

# ===== CORS =====
CORS_ORIGIN=http://localhost:3000
