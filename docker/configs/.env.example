# Environment Configuration
# Copy this file to .env and fill in your values

# ============================
# Database
# ============================
DB_HOST=postgres
DB_PORT=5432
DB_USER=balloo
DB_PASSWORD=your_secure_password_here
DB_NAME=balloo_production
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# ============================
# Redis
# ============================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================
# JWT & Security
# ============================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=32-character-encryption-key-here

# ============================
# CORS
# ============================
CORS_ORIGIN=https://app.balloo.ru

# ============================
# Yandex OAuth
# ============================
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
YANDEX_REDIRECT_URI=https://app.balloo.ru/auth/yandex/callback

# ============================
# Yandex Disk
# ============================
YANDEX_DISK_CLIENT_ID=your_yandex_disk_client_id
YANDEX_DISK_CLIENT_SECRET=your_yandex_disk_client_secret
YANDEX_DISK_FOLDER=balloo-uploads

# ============================
# Email (SMTP)
# ============================
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_USER=your_email@yandex.ru
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@balloo.ru

# ============================
# SMS / Max Server
# ============================
MAX_SERVER_URL=http://max-server:8080
MAX_SERVER_API_KEY=your_max_server_api_key
SMS_SERVER_URL=http://max-server:8080
SMS_SERVER_API_KEY=your_max_server_api_key

# ============================
# Push Notifications
# ============================
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@balloo.ru

# ============================
# Storage
# ============================
STORAGE_PROVIDER=yandex
MAX_FILE_SIZE=52428800
UPLOAD_DIR=/app/uploads
RECORDINGS_DIR=/app/recordings

# ============================
# Features
# ============================
REGISTRATION_ENABLED=true
MAINTENANCE_MODE=false
PUSH_NOTIFICATIONS_ENABLED=true
E2E_ENCRYPTION_ENABLED=true
VIDEO_CALLS_ENABLED=true
FILE_UPLOAD_ENABLED=true
INVITATION_SYSTEM_ENABLED=true
ADMIN_PANEL_ENABLED=true
MULTI_ACCOUNT_ENABLED=true

# ============================
# Rate Limiting
# ============================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ============================
# Message Retention
# ============================
MESSAGE_RETENTION_DAYS=90

# ============================
# Admin
# ============================
SUPER_ADMIN_EMAIL=admin@balloo.ru
DEFAULT_ADMIN_PASSWORD=Admin123!

# ============================
# Test Users
# ============================
TEST_USER_1_EMAIL=test1@balloo.ru
TEST_USER_1_PASSWORD=Test1234!
TEST_USER_1_NAME=Test User 1
TEST_USER_1_IS_ADMIN=false
TEST_USER_1_IS_SUPER_ADMIN=false
