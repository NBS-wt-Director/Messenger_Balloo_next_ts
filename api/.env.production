# ============================================
# App Balloo API - Production Environment
# ============================================

# ============================================
# SERVER
# ============================================
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://app.balloo.ru
CORS_ORIGIN=https://app.balloo.ru

# ============================================
# DATABASE (PostgreSQL)
# ============================================
DATABASE_URL=postgresql://balloo:YOUR_SECURE_PASSWORD_HERE@localhost:5432/balloo_production
DB_POOL_SIZE=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_STATEMENT_TIMEOUT=30000

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT
# ============================================
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_MIN_64_CHARACTERS_CHANGE_THIS_IN_PRODUCTION
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=32-character-encryption-key-for-yandex-tokens-change-this

# ============================================
# MAX SMS SERVER
# ============================================
MAX_SERVER_URL=http://localhost:8080
MAX_SERVER_API_KEY=your-max-server-api-key-change-this

# ============================================
# YANDEX OAUTH
# ============================================
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
YANDEX_REDIRECT_URI=https://api.balloo.ru/api/v1/auth/yandex/callback

# ============================================
# YANDEX DISK
# ============================================
YANDEX_DISK_BASE_URL=https://cloud-api.yandex.net/v1/disk
YANDEX_DISK_CLIENT_ID=your-yandex-disk-client-id
YANDEX_DISK_CLIENT_SECRET=your-yandex-disk-client-secret

# ============================================
# EMAIL (SMTP)
# ============================================
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_USER=your-email@yandex.ru
EMAIL_PASSWORD=your-app-password

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads
STORAGE_PROVIDER=yandex

# ============================================
# RECORDINGS
# ============================================
RECORDINGS_DIR=./recordings

# ============================================
# CLEANUP SETTINGS
# ============================================
MESSAGE_RETENTION_DAYS=90

# ============================================
# 2FA ROUTER SETTINGS
# ============================================
MAX_2FA_FAILURES=10
RECOVERY_TIME_MS=1800000

# ============================================
# BACKUP SETTINGS
# ============================================
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
