 {
  "name": "app-balloo-api",
  "version": "1.0.0",
  "description": "API server for App Balloo messenger with E2E encryption and Yandex integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "db:init": "node src/scripts/init-database.js",
    "backup:create": "node scripts/backup.js create",
    "backup:clean": "node scripts/backup.js clean",
    "backup:list": "node scripts/backup.js list",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["api", "messenger", "websocket", "e2e-encryption", "yandex"],
  "author": "",
  "license": "MIT",
"dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "winston": "^3.11.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "sql.js": "^1.10.3",
    "crypto-js": "^4.2.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "ws": "^8.14.2",
    "uuid": "^9.0.1",
    "express-rate-limit": "^7.1.5",
    "axios": "^1.6.2",
    "nodemailer": "^6.9.16",
    "zod": "^3.23.8",
    "ioredis": "^5.3.2",
    "bull": "^4.12.0",
    "pg": "^8.11.3",
    "rate-limit-redis": "^4.2.0"
  },
"devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "typescript": "^5.7.0",
    "ts-node": "^10.9.0",
    "@types/node": "^22.10.0",
    "@types/jest": "^29.5.14",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^1.4.0",
    "@types/node-fetch": "^2.6.0",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.0",
    "@types/nodemailer": "^6.4.0"
  }
}
