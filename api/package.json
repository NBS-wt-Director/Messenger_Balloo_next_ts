 {
  "name": "app-balloo-api",
  "version": "1.0.0",
  "description": "API server for App Balloo messenger with E2E encryption and Yandex integration",
  "main": "src/index.js",
"scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "db:init": "node src/scripts/init-database.js",
    "backup:create": "node scripts/backup.js create",
    "backup:clean": "node scripts/backup.js clean",
    "backup:list": "node scripts/backup.js list"
  },
  "keywords": ["api", "messenger", "websocket", "e2e-encryption", "yandex"],
  "author": "",
  "license": "MIT",
"dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "winston": "^3.11.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "sql.js": "^1.10.3",
    "crypto-js": "^4.2.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^2.7.0",
    "ws": "^8.14.2",
    "uuid": "^9.0.1",
    "express-rate-limit": "^7.1.5",
    "axios": "^1.6.2",
    "nodemailer": "^6.9.16",
    "zod": "^3.23.8",
    "ioredis": "^5.3.2",
    "bull": "^4.12.0",
    "pg": "^8.11.3",
    "rate-limit-redis": "^4.2.0"
