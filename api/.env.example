# ============================================
# DATABASE (PostgreSQL - Required for production)
# ============================================
# SQLite (deprecated, for migration only)
DB_PATH=./data/database.sqlite

# PostgreSQL (production)
DATABASE_URL=postgresql://balloo:your-secure-password@localhost:5432/balloo_production

# ============================================
# REDIS (Required for production)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# SERVER
# ============================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ============================================
# JWT
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-64-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# YANDEX OAUTH
# ============================================
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
YANDEX_REDIRECT_URI=http://localhost:3001/api/v1/auth/yandex/callback

# ============================================
# YANDEX DISK
# ============================================
YANDEX_DISK_BASE_URL=https://cloud-api.yandex.net/v1/disk

# ============================================
# EMAIL (SMTP)
# ============================================
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_USER=your-email@yandex.ru
EMAIL_PASSWORD=your-app-password

# ============================================
# SECURITY
# ============================================
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=32-character-encryption-key-for-yandex-tokens
CORS_ORIGIN=http://localhost:3000

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# ============================================
# RECORDINGS
# ============================================
RECORDINGS_DIR=./recordings

# ============================================
# STORAGE PROVIDER
# ============================================
STORAGE_PROVIDER=yandex
LOCAL_STORAGE_PATH=./uploads

# ============================================
# CLEANUP SETTINGS
# ============================================
MESSAGE_RETENTION_DAYS=90

# ============================================
# 2FA ROUTER SETTINGS
# ============================================
MAX_2FA_FAILURES=10
RECOVERY_TIME_MS=1800000
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
YANDEX_REDIRECT_URI=http://localhost:3001/api/v1/auth/yandex/callback

# Yandex Disk
YANDEX_DISK_BASE_URL=https://cloud-api.yandex.net/v1/disk

# Email (for password reset, verification codes)
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=587
EMAIL_USER=your-email@yandex.ru
EMAIL_PASSWORD=your-app-password

# Security
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=32-character-encryption-key-for-yandex-tokens

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# Recordings
RECORDINGS_DIR=./recordings

# ============================================
# REDIS (Required for production)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# STORAGE PROVIDER
# ============================================
# Options: yandex, s3, local
STORAGE_PROVIDER=yandex

# Local storage path (if using local provider)
LOCAL_STORAGE_PATH=./uploads

# ============================================
# CLEANUP SETTINGS
# ============================================
MESSAGE_RETENTION_DAYS=90

# ============================================
# 2FA ROUTER SETTINGS
# ============================================
MAX_2FA_FAILURES=10
RECOVERY_TIME_MS=1800000
