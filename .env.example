# Balloo Platform - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ==================== DATABASE ====================
DB_PASSWORD=your_secure_postgres_password
DATABASE_URL=postgresql://balloo:YOUR_PASSWORD@localhost:5432/balloo

# ==================== REDIS ====================
REDIS_URL=redis://localhost:6379

# ==================== YANDEX OAUTH ====================
YANDEX_CLIENT_ID=your-yandex-client-id
YANDEX_CLIENT_SECRET=your-yandex-client-secret
YANDEX_REDIRECT_URI=https://balloo.su/auth/yandex/callback

# ==================== YANDEX DISK ====================
YANDEX_DISK_TOKEN=your-yandex-disk-oauth-token
YANDEX_DISK_FOLDER=/balloo-storage

# ==================== EMAIL (YANDEX SMTP) ====================
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your-yandex-email@yandex.ru
SMTP_PASSWORD=your-yandex-app-password
SMTP_FROM=noreply@balloo.su

# ==================== CREATOR SUPERADMIN ====================
CREATOR_EMAIL=o8eryuhtin@yandex.ru
CREATOR_PHONE=+79292167585
CREATOR_PASSWORD=your_admin_password_6_9_chars

# ==================== JWT ====================
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long

# ==================== APP URLs ====================
BALLOO_URL=https://balloo.su
MESSENGER_URL=https://messenger.balloo.su
ADMIN_URL=https://admin.balloo.su
WORKING_URL=https://working.balloo.su
API_URL=https://api.working.balloo.su

# ==================== SMS NODE ====================
SMS_API_URL=https://api.working.balloo.su/sms
SMS_API_TOKEN=your-sms-api-token

# ==================== NODE IDs ====================
NODE_ID=balloo.su
NODE_ENV=production

# ==================== SSL ====================
SSL_CERT_PATH=/etc/letsencrypt/live/balloo.su/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/balloo.su/privkey.pem

# ==================== GRAFANA (OPTIONAL) ====================
GRAFANA_PASSWORD=admin

# ==================== FILE UPLOAD LIMITS ====================
MAX_FILE_SIZE=26214400
# 25 MB in bytes

# ==================== RATE LIMITS ====================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== SESSION ====================
SESSION_SECRET=your_session_secret_min_32_chars
SESSION_MAX_AGE=2592000000
# 30 days in milliseconds

# ==================== CORS ====================
CORS_ORIGINS=https://balloo.su,https://messenger.balloo.su,https://admin.balloo.su,https://working.balloo.su
